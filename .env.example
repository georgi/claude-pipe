# The agent harness reads provider credentials from these — set whichever
# matches your model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only for the codex harness, and only if you aren't signed in via `codex login`.
CODEX_API_KEY=

# Agent harness that drives conversations:
#   pi     - Pi Coding Agent SDK (multi-provider; default)
#   claude - Claude Agent SDK (Anthropic models only; needs ANTHROPIC_API_KEY)
#   codex  - OpenAI Codex SDK (OpenAI models only; needs `codex login` or CODEX_API_KEY)
CLAUDEPIPE_HARNESS=pi

# Workspace root for file/system tools.
CLAUDEPIPE_WORKSPACE=/path/to/your/workspace

# Session map persistence (conversation_key -> pi session file path)
CLAUDEPIPE_SESSION_STORE_PATH=/path/to/your/workspace/data/sessions.json

# Optional summary prompt templating for workspace-summary requests
CLAUDEPIPE_SUMMARY_PROMPT_ENABLED=true
CLAUDEPIPE_SUMMARY_PROMPT_TEMPLATE=Workspace: {{workspace}}\nRequest: {{request}}\nProvide a concise summary with key files and actionable insights.

# Optional transcript logging (off by default)
CLAUDEPIPE_TRANSCRIPT_LOG_ENABLED=false
CLAUDEPIPE_TRANSCRIPT_LOG_PATH=/path/to/your/workspace/data/transcript.jsonl
CLAUDEPIPE_TRANSCRIPT_LOG_MAX_BYTES=1000000
CLAUDEPIPE_TRANSCRIPT_LOG_MAX_FILES=3

# Telegram channel
CLAUDEPIPE_TELEGRAM_ENABLED=false
CLAUDEPIPE_TELEGRAM_TOKEN=
CLAUDEPIPE_TELEGRAM_ALLOW_FROM=

# Discord channel
CLAUDEPIPE_DISCORD_ENABLED=false
CLAUDEPIPE_DISCORD_TOKEN=
CLAUDEPIPE_DISCORD_ALLOW_FROM=
# Each new conversation gets its own thread (and its own session). Set to false to reply in-channel.
CLAUDEPIPE_DISCORD_USE_THREADS=true

# Optional: tuning
CLAUDEPIPE_MAX_TOOL_ITERATIONS=20
